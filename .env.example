# ローカル開発用の雛形です。
# 使い方:
#   1) cp .env.example .env.local
#   2) .env.local を編集して値を埋める
# 注意:
#   - .env.local はコミットしません（.gitignore 済み）
#   - VITE_* はフロントに埋め込まれるため、Secrets（サーバ側シークレット）を入れないでください

# --- 必須: Firebase Web SDK（Firebase Console → Project settings → Your apps → Web app）
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# --- 任意: Firebase Web SDK（機能を使う場合）
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# 任意: Google Analytics（未設定なら無効化される想定）
VITE_FIREBASE_MEASUREMENT_ID=

# --- 任意: 機能フラグ（"true" のときのみ有効）
# ゲスト統合のバックエンド経路を有効化
VITE_ENABLE_BACKEND_GUEST_MERGE=

# OCR（手書きメモ）導線を有効化
VITE_ENABLE_OCR_HANDWRITTEN_MEMO=

# --- 任意: Vite base（サブパス配信時など。未設定なら "/"）
VITE_BASE=/
